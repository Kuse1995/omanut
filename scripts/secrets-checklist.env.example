# Edge Function Secrets Checklist for omanut-prod (ref: rwjeuiwaiflidurgqpks)
# 1. Copy this file locally:
#      cp scripts/secrets-checklist.env.example scripts/secrets.env.local
# 2. Fill in the live production values below (do NOT commit secrets.env.local).
# 3. Upload to Supabase Edge Functions in one command:
#      supabase secrets set --env-file scripts/secrets.env.local --project-ref rwjeuiwaiflidurgqpks --workdir supabase/.temp/cli-workdir

# --- Public App & OAuth Origins ---
PUBLIC_APP_URL=https://assistant.omanut.me
SOCIAL_CONNECT_ORIGIN=https://assistant.omanut.me
SOCIAL_OAUTH_STATE_SECRET=replace-with-32-byte-random-hex

# --- Shared WhatsApp Marketer Hub (+260768737233) ---
MARKETER_WHATSAPP_NUMBER=+260768737233
A2UI_TOKEN_SECRET=replace-with-32-byte-random-hex

# --- Direct AI Provider Keys ---
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# --- Image / Video Generation ---
FAL_KEY=
FAL_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=

# --- Twilio (WhatsApp & Voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Meta / Facebook / Instagram / WhatsApp Cloud ---
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=1683300603007251
META_WEBHOOK_VERIFY_TOKEN=

# --- LinkedIn & TikTok ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://assistant.omanut.me/auth/linkedin/callback
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
LINKEDIN_PAGES_REDIRECT_URI=https://assistant.omanut.me/auth/linkedin-pages/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://assistant.omanut.me/auth/tiktok/callback
TIKTOK_ENV=production

# --- Email & Google ---
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- BMS / Finch Bridge ---
BMS_BRIDGE_SECRET=

# --- Legacy / Optional ---
ADMIN_WHATSAPP_NUMBERS=
